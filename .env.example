# Core
DATABASE_URL="postgresql://user:password@localhost:5432/newcrm"
# For local dev you can use: "file:./prisma/dev.db" (switch provider to sqlite)

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (used for sign-in + Gmail sync)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Webhook signing secret (used to sign outgoing webhooks HMAC-SHA256)
WEBHOOK_SIGNING_SECRET="change-me"

# ── Meta Conversions API (CAPI) — lead-quality feedback loop ────────────────
# When a lead's status changes in the CRM, a server event is sent back to
# Meta's dataset so it learns which leads are good vs. junk. Leave DATASET_ID
# and ACCESS_TOKEN blank to disable (all CAPI calls become no-ops).
# From Events Manager → your dataset → Connect data (see the setup guide).
META_CAPI_DATASET_ID=""            # e.g. 523876770030049 (a.k.a. pixel/dataset ID)
META_CAPI_ACCESS_TOKEN=""          # generate under "3. Create endpoint"
META_CAPI_API_VERSION="v25.0"      # Graph API version from the endpoint URL
# Optional: send events to the "Test events" tab instead of production while
# you verify the integration. Copy from Events Manager → Test events.
META_CAPI_TEST_EVENT_CODE=""
# Optional: label shown to Meta as the lead source (your CRM's name).
META_CAPI_LEAD_EVENT_SOURCE="new-crm"
# Optional: default country calling code (digits only) prepended to 10-digit
# local phone numbers before hashing, so they match Meta's records. e.g. 91 (IN).
META_CAPI_DEFAULT_COUNTRY_CODE=""
# Optional: JSON overriding the CRM-status → Meta event_name map. Set a stage
# to "" to stop reporting it. Defaults:
# {"POTENTIAL":"Lead","QUALIFIED":"QualifiedLead","CUSTOMER":"Purchase","BAD_FIT":"DisqualifiedLead","CHURNED":"ChurnedLead"}
META_CAPI_EVENT_MAP=""

# Optional: bootstrap first admin by email (case-insensitive)
BOOTSTRAP_ADMIN_EMAIL=""

# Optional: enables a password-only sign-in flow (no Google required).
# When set, the /signin page shows an email + password form. The shared
# password is validated against this value — any email can sign in, and
# the matching User row is created on first login. Unset to disable.
DEV_LOGIN_PASSWORD=""
