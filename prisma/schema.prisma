// Prisma schema for new-crm
// Default provider: postgresql (Vercel Postgres / Neon / Supabase).
// For local dev you can switch to sqlite by changing `provider = "sqlite"`
// and DATABASE_URL="file:./dev.db"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  WON
  LOST
}

enum ActivityType {
  NOTE
  CALL
  MEETING
  TASK
  EMAIL
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  URL
}

enum CustomFieldEntity {
  CONTACT
  LEAD
  OPPORTUNITY
}

enum WebhookEvent {
  CONTACT_CREATED
  CONTACT_UPDATED
  CONTACT_DELETED
  LEAD_CREATED
  LEAD_UPDATED
  LEAD_DELETED
  OPPORTUNITY_CREATED
  OPPORTUNITY_UPDATED
  OPPORTUNITY_STAGE_CHANGED
  OPPORTUNITY_DELETED
  ACTIVITY_CREATED
  EMAIL_RECEIVED
  EMAIL_SENT
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String?
  image           String?
  role            Role     @default(USER)
  emailVerified   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts        Account[]
  sessions        Session[]

  ownedContacts      Contact[]     @relation("ContactOwner")
  ownedLeads         Lead[]        @relation("LeadOwner")
  ownedOpportunities Opportunity[] @relation("OpportunityOwner")
  activities         Activity[]
  apiKeys            ApiKey[]
  emails             Email[]
  gmailSync          GmailSync?
}

// NextAuth (Auth.js) models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Contact {
  id          String   @id @default(cuid())
  firstName   String?
  lastName    String?
  email       String?
  phone       String?
  company     String?
  title       String?
  avatarUrl   String?
  notes       String?
  customData  Json     @default("{}")
  ownerId     String?
  owner       User?    @relation("ContactOwner", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads         Lead[]
  opportunities Opportunity[]
  activities    Activity[]
  emails        Email[]

  @@index([email])
  @@index([ownerId])
}

model Lead {
  id         String     @id @default(cuid())
  title      String
  status     LeadStatus @default(NEW)
  source     String?
  value      Decimal?   @db.Decimal(12, 2)
  contactId  String?
  contact    Contact?   @relation(fields: [contactId], references: [id])
  ownerId    String?
  owner      User?      @relation("LeadOwner", fields: [ownerId], references: [id])
  customData Json       @default("{}")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  activities Activity[]

  @@index([status])
  @@index([ownerId])
}

model Pipeline {
  id        String         @id @default(cuid())
  name      String
  isDefault Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  stages        PipelineStage[]
  opportunities Opportunity[]
}

model PipelineStage {
  id          String    @id @default(cuid())
  pipelineId  String
  pipeline    Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name        String
  order       Int
  probability Int       @default(0) // 0-100
  isWon       Boolean   @default(false)
  isLost      Boolean   @default(false)

  opportunities Opportunity[]

  @@index([pipelineId, order])
}

model Opportunity {
  id         String         @id @default(cuid())
  name       String
  value      Decimal        @default(0) @db.Decimal(12, 2)
  currency   String         @default("USD")
  pipelineId String
  pipeline   Pipeline       @relation(fields: [pipelineId], references: [id])
  stageId    String
  stage      PipelineStage  @relation(fields: [stageId], references: [id])
  stageOrder Int            @default(0) // position inside the stage column
  contactId  String?
  contact    Contact?       @relation(fields: [contactId], references: [id])
  ownerId    String?
  owner      User?          @relation("OpportunityOwner", fields: [ownerId], references: [id])
  expectedCloseAt DateTime?
  closedAt   DateTime?
  customData Json           @default("{}")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  activities Activity[]

  @@index([pipelineId, stageId, stageOrder])
  @@index([ownerId])
}

model Activity {
  id            String       @id @default(cuid())
  type          ActivityType
  title         String
  body          String?
  dueAt         DateTime?
  completedAt   DateTime?
  userId        String?
  user          User?        @relation(fields: [userId], references: [id])
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id])
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([type])
  @@index([contactId])
  @@index([opportunityId])
}

model CustomField {
  id        String             @id @default(cuid())
  entity    CustomFieldEntity
  key       String
  label     String
  type      CustomFieldType
  required  Boolean            @default(false)
  options   Json?              // for SELECT: array of {label, value}
  order     Int                @default(0)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([entity, key])
}

model ApiKey {
  id         String   @id @default(cuid())
  name       String
  prefix     String   @unique              // first 8 chars shown to user
  hash       String                        // sha256 of full key
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model WebhookEndpoint {
  id         String          @id @default(cuid())
  url        String
  secret     String          // per-endpoint signing secret
  events     WebhookEvent[]
  active     Boolean         @default(true)
  description String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id           String          @id @default(cuid())
  endpointId   String
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event        WebhookEvent
  payload      Json
  status       Int?            // http status
  responseBody String?         @db.Text
  error        String?         @db.Text
  attempt      Int             @default(1)
  deliveredAt  DateTime?
  createdAt    DateTime        @default(now())

  @@index([endpointId, createdAt])
}

model GmailSync {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  historyId     String?
  lastSyncedAt  DateTime?
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Email {
  id          String   @id @default(cuid())
  gmailId     String?  @unique
  threadId    String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id])
  fromEmail   String
  fromName    String?
  toEmails    String[] // Postgres text array
  subject     String
  snippet     String?
  bodyHtml    String?  @db.Text
  bodyText    String?  @db.Text
  direction   String   // "inbound" | "outbound"
  sentAt      DateTime
  createdAt   DateTime @default(now())

  @@index([contactId, sentAt])
  @@index([userId, sentAt])
}
