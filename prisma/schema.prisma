// Prisma schema for new-crm
// Model:
//   Lead  ─── has many ──► Contacts
//                       ─► Opportunities
//                       ─► Activities
//   A Contact belongs to (at most) one Lead.
//   An Opportunity belongs to exactly one Lead.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("NEW_CRM_DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum LeadStatus {
  POTENTIAL
  QUALIFIED
  INTERESTED
  CUSTOMER
  BAD_FIT
  CHURNED
}

enum ActivityType {
  NOTE
  CALL
  MEETING
  TASK
  EMAIL
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  URL
}

enum CustomFieldEntity {
  LEAD
  CONTACT
  OPPORTUNITY
}

enum WebhookEvent {
  CONTACT_CREATED
  CONTACT_UPDATED
  CONTACT_DELETED
  LEAD_CREATED
  LEAD_UPDATED
  LEAD_DELETED
  OPPORTUNITY_CREATED
  OPPORTUNITY_UPDATED
  OPPORTUNITY_STAGE_CHANGED
  OPPORTUNITY_DELETED
  ACTIVITY_CREATED
  EMAIL_RECEIVED
  EMAIL_SENT
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  title         String?
  role          Role      @default(USER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  ownedLeads         Lead[]        @relation("LeadOwner")
  ownedContacts      Contact[]     @relation("ContactOwner")
  ownedOpportunities Opportunity[] @relation("OpportunityOwner")
  activities         Activity[]
  assignedTasks      Activity[]    @relation("TaskAssignee")
  apiKeys            ApiKey[]
  emails             Email[]
  emailTemplates     EmailTemplate[]
  gmailSync          GmailSync?
  invitesSent        Invite[]      @relation("InviteSender")
  smartViews         SmartView[]
  workflows          Workflow[]
  bookmarks          Bookmark[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Lead = a company/account. Has many contacts, opportunities, activities.
model Lead {
  id          String     @id @default(cuid())
  name        String     // company name
  status      LeadStatus @default(POTENTIAL)
  source      String     @default("MANUAL") // "MANUAL" or "API"
  url         String?
  description String?
  address     String?
  // Meta-generated Lead ID (15–17 digits) from the originating Facebook/
  // Instagram Lead Ad. Captured at ingest so we can send Conversions API
  // events back to Meta keyed to the exact lead. Null for non-Meta leads.
  metaLeadId  String?
  customData  Json       @default("{}")
  ownerId     String?
  owner       User?      @relation("LeadOwner", fields: [ownerId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  contacts      Contact[]
  opportunities Opportunity[]
  activities    Activity[]

  @@index([status])
  @@index([ownerId])
  @@index([metaLeadId])
}

model Contact {
  id         String   @id @default(cuid())
  firstName  String?
  lastName   String?
  email      String?
  phone      String?
  title      String?
  avatarUrl  String?
  notes      String?
  customData Json     @default("{}")
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  ownerId    String?
  owner      User?    @relation("ContactOwner", fields: [ownerId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activities Activity[]
  emails     Email[]

  @@index([email])
  @@index([leadId])
  @@index([ownerId])
}

model Pipeline {
  id        String   @id @default(cuid())
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages        PipelineStage[]
  opportunities Opportunity[]
}

model PipelineStage {
  id          String  @id @default(cuid())
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name        String
  order       Int
  probability Int     @default(0)
  isWon       Boolean @default(false)
  isLost      Boolean @default(false)

  opportunities Opportunity[]

  @@index([pipelineId, order])
}

model Opportunity {
  id              String         @id @default(cuid())
  name            String
  value           Decimal        @default(0) @db.Decimal(12, 2)
  currency        String         @default("INR")
  pipelineId      String
  pipeline        Pipeline       @relation(fields: [pipelineId], references: [id])
  stageId         String
  stage           PipelineStage  @relation(fields: [stageId], references: [id])
  stageOrder      Int            @default(0)
  leadId          String
  lead            Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ownerId         String?
  owner           User?          @relation("OpportunityOwner", fields: [ownerId], references: [id])
  expectedCloseAt DateTime?
  closedAt        DateTime?
  finalQuote      String?
  sow             String[]       @default([])
  customData      Json           @default("{}")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  activities Activity[]

  @@index([leadId])
  @@index([pipelineId, stageId, stageOrder])
  @@index([ownerId])
}

model Activity {
  id            String       @id @default(cuid())
  type          ActivityType
  title         String
  body          String?
  dueAt         DateTime?
  completedAt   DateTime?
  priority      TaskPriority @default(MEDIUM)
  assigneeId    String?
  assignee      User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  reminderAt    DateTime?
  reminded      Boolean      @default(false)
  userId        String?
  user          User?        @relation(fields: [userId], references: [id])
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([type])
  @@index([leadId])
  @@index([contactId])
  @@index([opportunityId])
  @@index([assigneeId])
  @@index([dueAt])
}

/// A custom field is a workspace-wide definition that applies to every entity
/// (Lead, Contact, Opportunity). Each entity stores its value inside its own
/// customData JSON blob keyed by CustomField.key.
model CustomField {
  id        String              @id @default(cuid())
  key       String              @unique
  label     String
  type      CustomFieldType
  required  Boolean             @default(false)
  options   Json?
  order     Int                 @default(0)
  appliesTo CustomFieldEntity[] @default([LEAD, CONTACT, OPPORTUNITY])
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model ApiKey {
  id         String   @id @default(cuid())
  name       String
  prefix     String   @unique
  hash       String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
}

model WebhookEndpoint {
  id          String         @id @default(cuid())
  url         String
  secret      String
  events      WebhookEvent[]
  active      Boolean        @default(true)
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id           String          @id @default(cuid())
  endpointId   String
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event        WebhookEvent
  payload      Json
  status       Int?
  responseBody String?         @db.Text
  error        String?         @db.Text
  attempt      Int             @default(1)
  deliveredAt  DateTime?
  createdAt    DateTime        @default(now())

  @@index([endpointId, createdAt])
}

model GmailSync {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  historyId    String?
  lastSyncedAt DateTime?
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// A pending invitation issued by an admin. When the invited email signs
/// in for the first time, their User record is upgraded to the invite's
/// role and the invite is marked accepted.
model Invite {
  id          String    @id @default(cuid())
  email       String
  token       String    @unique
  role        Role      @default(USER)
  invitedById String?
  invitedBy   User?     @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@index([invitedById])
}

/// Shared email templates. Supports {{placeholder}} tokens that are
/// substituted client-side when composing from a Lead/Contact/Opportunity.
model EmailTemplate {
  id        String   @id @default(cuid())
  name      String
  subject   String
  body      String   @db.Text
  createdBy String?
  creator   User?    @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdBy])
}

/// Delivery log for Meta Conversions API (CAPI) events. One row per event we
/// attempt to POST to Meta's dataset endpoint when a lead's status changes.
/// Mirrors the WebhookDelivery pattern so failures are debuggable in the DB
/// (open Events Manager → Diagnostics to cross-check on Meta's side).
model MetaCapiEvent {
  id         String     @id @default(cuid())
  leadId     String?
  eventName  String
  status     LeadStatus
  metaLeadId String?
  eventId    String // dedup key sent to Meta as event_id
  httpStatus Int?
  fbTraceId  String? // Meta's fbtrace_id from the response, for support tickets
  eventsReceived Int? // events_received echoed back by Meta on success
  response   String?    @db.Text
  error      String?    @db.Text
  testMode   Boolean    @default(false)
  createdAt  DateTime   @default(now())

  @@index([leadId, createdAt])
  @@index([createdAt])
}

model Email {
  id        String   @id @default(cuid())
  gmailId   String?  @unique
  threadId  String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])
  fromEmail String
  fromName  String?
  toEmails  String[]
  subject   String
  snippet   String?
  bodyHtml  String?  @db.Text
  bodyText  String?  @db.Text
  direction String
  sentAt    DateTime
  createdAt DateTime @default(now())

  @@index([contactId, sentAt])
  @@index([userId, sentAt])
}

/// Saved filter views for leads/opportunities. Filters are stored as a JSON
/// array of conditions that get translated into Prisma where clauses at query
/// time. Users can pin views to the sidebar for quick access.
model SmartView {
  id        String   @id @default(cuid())
  name      String
  entity    String   @default("LEAD") // LEAD or OPPORTUNITY
  filters   Json     @default("{}") // { match: "all"|"any", conditions: [...] }
  pinned    Boolean  @default(false)
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

/// Internal automation workflow. A trigger (e.g. lead status changes to
/// QUALIFIED) fires one or more actions (e.g. create a task with a 24h due date).
model Workflow {
  id        String   @id @default(cuid())
  name      String
  active    Boolean  @default(true)
  trigger   Json     // { event: "LEAD_STATUS_CHANGED", conditions: { status: "QUALIFIED" } }
  actions   Json     // [{ type: "CREATE_TASK", config: { title: "...", priority: "HIGH", dueInHours: 24 } }]
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([active])
}

/// User-saved bookmarks shown in the sidebar. Quick access to docs, SOPs,
/// shared Notion pages, Google Docs, etc. Ordered per user.
model Bookmark {
  id        String   @id @default(cuid())
  title     String
  url       String
  folder    String?  // optional grouping — null = ungrouped
  order     Int      @default(0)
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, order])
  @@index([ownerId, folder])
}
